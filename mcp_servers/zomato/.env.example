# ── Zomato MCP — environment variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Run `python zomato_setup.py` once to auto-populate most of these.

# ── Device identity (auto-generated by zomato_setup.py) ──────────────────────
ZOMATO_ANDROID_ID=your-uuid-here          # stable UUID, generated on first setup

# ── Your account defaults (set during setup) ─────────────────────────────────
ZOMATO_PHONE=+91XXXXXXXXXX                # your registered Zomato phone number
ZOMATO_DEFAULT_LAT=23.0225               # default delivery latitude
ZOMATO_DEFAULT_LON=72.5714               # default delivery longitude
ZOMATO_DEFAULT_CITY_ID=8                 # Zomato city ID (8=Ahmedabad, 3=Mumbai, 4=Delhi)

# ── MCP server transport (set by Jarvis launcher, don't change manually) ─────
# ZOMATO_MCP_TRANSPORT=streamable-http   # set to "streamable-http" for Jarvis
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8765

# ── Optional: override token directly (normally stored in Windows Credential Manager)
# ZOMATO_ACCESS_TOKEN=your_token_here
