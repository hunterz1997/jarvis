# ============================================================
# JARVIS — Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control
# ============================================================

# --- Anthropic (REQUIRED) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- WhatsApp Bridge ---
WHATSAPP_BRIDGE_URL=http://localhost:3001

# --- Google OAuth (for Drive, Gmail, Calendar) ---
# Get from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Google MCP Endpoints ---
GOOGLE_DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1
GOOGLE_GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
GOOGLE_CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1

# --- Zomato ---
ZOMATO_MCP_URL=https://mcp-server.zomato.com/mcp

# --- Optional: Location ---
USER_CITY=Ahmedabad
USER_LOCATION_LAT=23.0225
USER_LOCATION_LON=72.5714

# --- Logging ---
LOG_LEVEL=INFO
